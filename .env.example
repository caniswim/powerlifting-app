# -----------------------------------------------------------------------------
# Copie para `.env` e preencha. `.env` está no .gitignore — nunca comite.
# Passo a passo do console: docs/firebase-setup.md
# -----------------------------------------------------------------------------

# --- App (Vite) --------------------------------------------------------------
# Config web do projeto Firebase. Não é segredo (vai no bundle do navegador por
# desenho); quem protege o dado é firestore.rules + Auth. Fica fora do git só
# para o repositório não carimbar o projeto de ninguém.
# Sem estas quatro variáveis o app roda 100% local, como antes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=

# Opcionais — o app não usa Storage nem Messaging hoje.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Script de briefing (Node) -----------------------------------------------
# `npm run briefing` entra com a MESMA conta de e-mail/senha do app.
# ESTES SIM SÃO SEGREDOS.
FIREBASE_EMAIL=
FIREBASE_PASSWORD=

# Opcional: quantas semanas o briefing traz (padrão 4).
BRIEFING_WEEKS=4
